{
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install": "npm run install:backend && npm run install:frontend",

    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    
    "lint:backend": "npm run lint --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint": "npm run lint:backend && npm run lint:frontend",
    
    "start:backend": "npm run start --prefix backend",
    "start:frontend": "npm run start --prefix frontend",

    "start:backend:dev": "npm run start:dev --prefix backend",
    "start:frontend:dev": "npm run dev --prefix frontend",
 
    "docker:dev:up": "docker compose -f docker-compose-dev.yaml up",
    "docker:dev:down": "docker compose -f docker-compose-dev.yaml down", 
    "docker:prod:up": "docker compose -f docker-compose-prod.yaml up",
    "docker:prod:down": "docker compose -f docker-compose-prod.yaml down",  
       
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend"
  }
}
